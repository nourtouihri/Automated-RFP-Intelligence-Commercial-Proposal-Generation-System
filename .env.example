# --- Ingestion -------------------------------------------------------------- 
## API_KEYS MUST be comma-separated.
## INGEST_SOURCES MUST be comma-separated
## order matters here. The first ingest source's API KEY should correspond to 
## the first one in INGEST_API_KEYS 
INGEST_SOURCES=
INGEST_API_KEYS=
## INGEST_LIMITS is comma-separated following the same order as INGEST_SOURCES:
## the first number is TED's per-page fetch limit, the second is SAM's.
## A source without a valid positive integer falls back to the built-in
## default (30 notices per page).
## SAM spends one API call per notice (its description) plus one per page, so
## keep its limit low: free SAM.gov keys allow only a few calls a day.
INGEST_LIMITS=30,10


# --- LLM (shared by detection, research and proposal) -----------------------
# Proposal uses it for prose only (brief/letter/summary/needs/evidence/approach);
# scores, names, prices and the no-bid gate are decided by code, and a no-bid
# deck spends zero model calls.
# anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
LLM_URL=
# Ollama example (LLM_API_KEY can stay empty for a local instance):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=qwen2.5:7b
#   LLM_URL=http://your-ollama-host:11434/v1/chat/completions

# --- Research -------------------------------------------------------------------
TAVILY_API_KEY=
INTERNAL_SERVICE_TOKEN=dev-secret-token # shared secret, n8n -> microservices auth

# Server budget sits under the n8n node's 45s client timeout so n8n never
# aborts mid-run while the server keeps burning search/LLM budget.
# PER_CALL_TIMEOUT_SECONDS also bounds every proposal deck's LLM call.
MAX_SEARCH_ITERATIONS=6
TOTAL_RUN_TIMEOUT_SECONDS=35
PER_CALL_TIMEOUT_SECONDS=8

# --- Proposal ---------------------------------------------------------------
# Decks (.pptx/.pdf/.matrix.csv) and the returned/result JSON are written here.
PROPOSAL_OUTPUT_DIR=/data/proposals
# One RAG query per tender requirement is issued by the proposal service itself.
RAG_URL=http://rag:8001
# Proposal's AI calls get their own timeout (default 120s), independent of
# PER_CALL_TIMEOUT_SECONDS which research keeps at 8.
#PER_CALL_TIMEOUT_PROPOSAL=120
# Optional proposal-only LLM: each PROPOSAL_LLM_* override shadows the shared
# LLM_* variable above for the deck service alone (detection/research keep the
# shared ones); empty/unset means "use the shared value". PROPOSAL_LLM_URL also
# switches the deck to the 2048-token OpenAI-compatible transport.
PROPOSAL_LLM_PROVIDER=
PROPOSAL_LLM_API_KEY=
PROPOSAL_LLM_MODEL=qwen2.5:7b-instruct
PROPOSAL_LLM_URL=
# Grounding verifier (proposal/verifier.py): the agent that judges every accepted
# reply against the sources it cites. It must be a DIFFERENT model than the
# writer, and never falls back to one: PROPOSAL_VERIFIER_LLM_MODEL names it, and
# when nothing is set the check is off (the demo says so). URL and key fall back
# PROPOSAL_VERIFIER_LLM_* -> PROPOSAL_LLM_* -> shared LLM_*, so usually only the
# model id changes.
PROPOSAL_VERIFIER_LLM_MODEL=gemma2:9b-instruct
PROPOSAL_VERIFIER_LLM_API_KEY=
PROPOSAL_VERIFIER_LLM_URL=

# --- RAG --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EMBEDDING_MODEL=

# --- Salesforce --------------------------------------------
SF_BASE_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_API_VERSION=59.0
SF_TIMEOUT_SECONDS=30

# --- Insight ---------------------------------------
INSIGHTS_LLM_PROVIDER=
INSIGHTS_LLM_MODEL=
INSIGHTS_LLM_API_KEY=
INSIGHTS_LLM_URL=