    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst limit = Math.min(Math.max(Number(body.limit) || 3, 1), 10);\n\n// TED and SAM take turns, so a short run still covers both sources. A failed SAM fetch (no API key) leaves only TED.\nconst queues = $input.all().map((item) => [...(item.json.notices || [])]);\nconst picked = [];\nwhile (picked.length < limit && queues.some((q) => q.length)) {\n  for (const q of queues) if (q.length && picked.length < limit) picked.push(q.shift());\n}\n\n// Same id the UI's \"Send to Detection\" gives a notice, so both paths land on one tender.\nreturn picked.map((notice) => ({\n  json: { ...notice, id: `${String(notice.source || 'TED').toLowerCase()}-${notice.id}` }\n}));\n"
      },
      "id": "fcd1fd2a-081a-44c4-9c8c-5fcacf945249",
      "name": "Pick Notices",
      "type": "n8n-nodes-base.code",
